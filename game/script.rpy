## ============================================================
## 共通线结束 - 分支判定
## ============================================================
label route_select:
    scene black with dissolve

    "共通线 · 完结"
    "根据好感度，进入以下路线："

    # 好感度排序与路线分配
    python:
        affinities = {
            "yanaami": yn_aff,
            "yakishio": sy_aff,
            "komari": xj_aff,
            "shiratama": by_aff,
            "tengoku": max_aff,
        }
        sorted_routes = sorted(affinities.items(), key=lambda x: x[1], reverse=True)
        route = sorted_routes[0][0]

        # 隐藏路线判定
        if zmx_aff >= 8:
            route = "shikishi"
        elif js_aff >= 10 and yn_aff < 5 and sy_aff < 5 and xj_aff < 5:
            route = "kaju"
        elif max(affinities.values()) - min(affinities.values()) <= 2:
            route = "harem"

    if route == "yanaami":
        jump route_yanaami
    elif route == "yakishio":
        jump route_yakishio
    elif route == "komari":
        jump route_komari
    elif route == "shiratama":
        jump route_shiratama
    elif route == "tengoku":
        jump route_max
    elif route == "shikishi":
        jump route_shikishi
    elif route == "kaju":
        jump route_kaju
    elif route == "harem":
        jump route_harem

    return
